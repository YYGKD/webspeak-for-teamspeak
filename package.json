{
  "name": "webspeak-webclient",
  "version": "0.2.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "web:dev": "cd web && npx vite --host",
    "web:build": "cd web && npx vite build",
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "e2e:mediasoup": "node scripts/mediasoup-e2e.mjs",
    "test": "node scripts/verify-worker.mjs && npx tsx scripts/media-worker-test.mjs && npx tsx scripts/speaker-producer-map-test.mjs && npx tsx scripts/upstream-pipeline-test.mjs && npx tsx scripts/audio-device-test.mjs && npx tsx scripts/screen-share-sfu-test.mjs && node scripts/mediasoup-e2e.mjs && npx tsx scripts/turn-credentials-test.mjs",
    "acceleration:poc": "node scripts/acceleration-poc/smoke.mjs",
    "acceleration:ipv6-smoke": "node scripts/acceleration-poc/smoke-ipv6.mjs",
    "acceleration:sdk-smoke": "node scripts/acceleration-poc/sdk-smoke.mjs",
    "acceleration:relay": "node dist/relay.js"
  },
  "dependencies": {
    "@echosixhiya/teamspeak-client": "git+https://github.com/EchoSixHIYA/teamspeak-js.git#be882e6a4ba12e0938fff2d06bdcc5b3bedeb232",
    "express": "^5.2.1",
    "mediasoup": "3.27.1",
    "pino": "^10.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@discordjs/opus": "^0.10.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "werift": "0.24.4"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  }
}
